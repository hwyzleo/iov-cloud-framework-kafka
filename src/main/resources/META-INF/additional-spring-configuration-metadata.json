  "properties": [
    {
      "name": "iov.kafka.topic-provisioning.enabled",
      "type": "java.lang.Boolean",
      "description": "是否启用 Kafka Topic Provisioning，默认 false。",
      "defaultValue": false
    },
    {
      "name": "iov.kafka.topic-provisioning.initial-delay",
      "type": "java.time.Duration",
      "description": "应用就绪后的首次执行延迟，默认 0s。",
      "defaultValue": "0s"
    },
    {
      "name": "iov.kafka.topic-provisioning.describe-timeout",
      "type": "java.time.Duration",
      "description": "describe 整次方法共享等待预算，默认 10s（短于 default.api.timeout.ms=30000）。",
      "defaultValue": "10s"
    },
    {
      "name": "iov.kafka.topic-provisioning.warmup.enabled",
      "type": "java.lang.Boolean",
      "description": "是否启用启动期连接预热，默认 true。",
      "defaultValue": true
    },
    {
      "name": "iov.kafka.topic-provisioning.warmup.attempts",
      "type": "java.lang.Integer",
      "description": "预热最大尝试次数，默认 3。",
      "defaultValue": 3
    },
    {
      "name": "iov.kafka.topic-provisioning.warmup.initial-backoff",
      "type": "java.time.Duration",
      "description": "预热首次退避间隔（按 2 倍增长），默认 1s。",
      "defaultValue": "1s"
    },
    {
      "name": "iov.kafka.topic-provisioning.retry.initial-interval",
      "type": "java.time.Duration",
      "description": "首次重试间隔，默认 5s。",
      "defaultValue": "5s"
    },
    {
      "name": "iov.kafka.topic-provisioning.retry.max-interval",
      "type": "java.time.Duration",
      "description": "最大重试间隔（封顶），默认 60s。",
      "defaultValue": "60s"
    },
    {
      "name": "iov.kafka.topic-provisioning.retry.multiplier",
      "type": "java.lang.Double",
      "description": "指数退避倍率，默认 2.0。",
      "defaultValue": 2.0
    },
    {
      "name": "iov.kafka.topic-provisioning.topics[].name",
      "type": "java.lang.String",
      "description": "Topic 名称，不能为空。",
      "sourceType": "net.hwyz.iov.cloud.framework.kafka.properties.KafkaTopicDefinitionProperties"
    },
    {
      "name": "iov.kafka.topic-provisioning.topics[].partitions",
      "type": "java.lang.Integer",
      "description": "分区数，必须大于等于 1。",
      "sourceType": "net.hwyz.iov.cloud.framework.kafka.properties.KafkaTopicDefinitionProperties"
    },
    {
      "name": "iov.kafka.topic-provisioning.topics[].replication-factor",
      "type": "java.lang.Short",
      "description": "副本数，必须大于等于 1。",
      "sourceType": "net.hwyz.iov.cloud.framework.kafka.properties.KafkaTopicDefinitionProperties"
    },
    {
      "name": "iov.kafka.topic-provisioning.topics[].configs",
